{
  "name": "sit753-student-platform",
  "version": "2.0.0",
  "description": "Production-like Student Management API for Jenkins DevOps pipeline practice.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build": "node -c src/server.js && node -c src/app.js && node -c src/config/index.js",
    "test": "jest --coverage --runInBand",
    "test:ci": "jest --coverage --runInBand --ci --reporters=default --reporters=jest-junit",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "prom-client": "^15.1.3",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "jest-junit": {
    "outputDirectory": ".",
    "outputName": "junit.xml"
  },
  "author": "Quang Nguyen",
  "license": "MIT"
}
